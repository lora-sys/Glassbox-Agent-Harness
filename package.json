{
  "name": "glassbox",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "packageManager": "npm@12.0.2",
  "scripts": {
    "glassbox": "tsx apps/server/src/cli.ts",
    "dev:server": "vp run -F @glassbox/server dev",
    "dev:web": "vp dev",
    "test:server": "vp test",
    "build:web": "vp build",
    "check": "vp check"
  },
  "dependencies": {
    "@glassbox/web": "^0.0.0",
    "@types/ws": "^8.18.1",
    "tldraw": "^5.3.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1",
    "vite-plus": "^0.3.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.3.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.21.0"
  }
}
