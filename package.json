{
  "name": "glassbox",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp hooks enable",
    "glassbox": "tsx apps/server/src/cli.ts",
    "dev:server": "vp run -F @glassbox/server dev",
    "agent:up": "tsx scripts/agent-service.mts up",
    "agent:status": "tsx scripts/agent-service.mts status",
    "agent:logs": "tsx scripts/agent-service.mts logs",
    "agent:inspect": "tsx scripts/inspect-latest-run.mts",
    "agent:down": "tsx scripts/agent-service.mts down",
    "dev:web": "vp dev",
    "test:unit": "vp test run --allowOnly=false --maxWorkers=4",
    "test:e2e": "vp test run --allowOnly=false --maxWorkers=4 apps/server/src/ops/p3-closed-loop.test.ts apps/server/src/management/application.test.ts",
    "test:regression": "vp test run --allowOnly=false --maxWorkers=4 apps/server/src/channels/onebot/dual-owner.test.ts apps/server/src/channels/onebot/onebot.test.ts apps/server/src/config/group-runtime.test.ts apps/server/src/delivery/presentation.test.ts apps/server/src/ops/reconciler.test.ts apps/server/src/ops/socket-herdr-bridge.test.ts apps/server/src/ops/trace-persistence.test.ts apps/server/src/persistence/foundation.test.ts apps/server/src/runtime/pi/owner-tools.test.ts apps/server/src/runtime/pi/skill-tools.test.ts",
    "check:core": "vp check --no-fmt apps/server packages/contracts scripts vite.config.ts",
    "build:web": "vp build",
    "verify:commit": "node scripts/verify-commit.mjs"
  },
  "dependencies": {
    "@glassbox/web": "^0.0.0",
    "@types/ws": "^8.18.1",
    "tldraw": "^5.3.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1",
    "vite-plus": "^0.3.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.3.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "npm@12.0.2"
}
