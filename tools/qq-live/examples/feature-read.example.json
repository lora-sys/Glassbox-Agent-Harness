{
  "schemaVersion": 2,
  "cases": [
    {
      "id": "qq-group-a-root-files-read",
      "chat": "private",
      "prompt": "帮我看看测试群 {{group:A}} 群文件根目录第一页有几个文件和文件夹。只统计这一页，不下载，也不要提供文件名、文件标识或上传者。请按一行回复 QQGROUPFILES {{nonce}} files=文件数 folders=文件夹数，方便我核对。",
      "expectContains": ["{{nonce}}"],
      "sideEffect": "none",
      "leaseTools": [
        {
          "name": "qq_group_files",
          "operations": [
            {
              "action": "group:files:read",
              "resourceId": "group:{{group:A}}",
              "inputConstraint": {
                "groupId": "{{group:A}}",
                "operation": "get_group_root_files"
              }
            }
          ]
        }
      ],
      "featureAssertions": [
        {
          "kind": "trace",
          "type": "tool_result",
          "where": {
            "name": "qq_group_files",
            "isError": false
          },
          "count": 1
        },
        {
          "kind": "group_files",
          "tool": "qq_group_files",
          "groupId": "{{group:A}}",
          "count": 1
        }
      ]
    },
