    {
      "id": "ops-status-read",
      "chat": "private",
      "prompt": "请调用 ops_status 查询当前授权可见的任务与 Worker 汇总数量。不要读取单个任务或修改状态。回复摘要和测试编号 {{nonce}}。",
      "expectContains": ["{{nonce}}"],
      "sideEffect": "none",
      "leaseTools": [
        {
          "name": "ops_status",
          "operations": [
            {
              "action": "ops:status",
              "resourceId": "agent-operations",
              "inputConstraint": {}
            }
          ]
        }
      ],
      "featureAssertions": [
        {
          "kind": "trace",
          "type": "tool_result",
          "where": {
            "name": "ops_status",
            "isError": false
          },
          "count": 1
        }
      ]
    },
