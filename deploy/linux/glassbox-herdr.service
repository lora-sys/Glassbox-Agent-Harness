[Unit]
Description=Glassbox Herdr worker host

[Service]
Type=simple
WorkingDirectory=%h/workspaces/glassbox-worker
Environment=PATH=%h/.local/opt/node-v24.21.0-linux-x64/bin:%h/.local/bin:%h/src/lora-pi-kit/node_modules/.bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/herdr --session glassbox-p3 server
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
