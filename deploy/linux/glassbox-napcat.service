[Unit]
Description=Glassbox NapCat QQ runtime

[Service]
Type=simple
WorkingDirectory=%h/src/Glassbox-Agent-Harness
EnvironmentFile=%h/.config/glassbox/napcat.env
ExecStartPre=/usr/bin/docker info --format {{.ServerVersion}}
ExecStart=%h/.local/bin/docker-compose -f %h/src/Glassbox-Agent-Harness/docs/napcat-linux.compose.yml up --no-color
ExecStop=%h/.local/bin/docker-compose -f %h/src/Glassbox-Agent-Harness/docs/napcat-linux.compose.yml down
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
