# Example only. Replace account and paths; use the same values for the CLI and service.
# No shell expansion: systemd does not expand ~, $HOME, or other variables here.
GLASSBOX_DATA_DIR=/home/glassbox/.glassbox
PORT=3030
LORA_PI_KIT_PATH=/home/glassbox/src/lora-pi-kit
PI_CODING_AGENT_DIR=/home/glassbox/.config/glassbox/pi-main
# Optional, only when the durable Temporal integration is configured:
# GLASSBOX_TEMPORAL_ADDRESS=127.0.0.1:7233
# GLASSBOX_TEMPORAL_NAMESPACE=default
# Keep credentials out of this example. Herdr uses its own Pi agent directory.
