# ==============================================================================
# Glassbox Agent Harness - 环境变量与协同配置模板
# 复制本文件为 .env：cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 核心服务网络配置
# ------------------------------------------------------------------------------
PORT=3030
# Glassbox 数据持久化目录（存放 SQLite 数据库、Token、运行时状态）
# 默认可在本机使用绝对路径（如 C:\Users\<Username>\.glassbox）或相对路径 ./data
GLASSBOX_DATA_DIR=./data

# ------------------------------------------------------------------------------
# 2. NapCat / OneBot QQ 接入配置
# ------------------------------------------------------------------------------
# NapCat 反向 WebSocket 上报连接地址（OneBot11 标准）
NAPCAT_WS_URL=ws://127.0.0.1:6700/
# NapCat HTTP API 地址（可选，用于主动调用 QQ API）
NAPCAT_HTTP_URL=http://127.0.0.1:3000/
# NapCat 访问令牌（若未设置鉴权可留空）
NAPCAT_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 3. 身份与多 Owner 协作配置
# ------------------------------------------------------------------------------
# Agent 机器人 QQ 号（必须与登录 NapCat 的 QQ 一致）
BOT_QQ=3394947361

# 主 Owner QQ 号（拥有全局最高管理与执行权限）
OWNER_QQ=3526039967

# 协同 Owner QQ 号（第二开发者，拥有对等 Owner 权限，但私聊/工作空间独立隔离）
CO_OWNER_QQ=

# 协同测试 QQ 群号
TEST_GROUP_ID=1126022432

# 测试用普通访客 QQ 号（用于测试权限拦截与沙箱策略）
TEST_VISITOR_QQ=3067670134

# ------------------------------------------------------------------------------
# 4. 运行时与引擎依赖
# ------------------------------------------------------------------------------
# Lora PI Kit 发行版路径（默认与 Glassbox 同级目录）
LORA_PI_KIT_PATH=../lora-pi-kit

# ------------------------------------------------------------------------------
# 5. 模型供应商凭据（至少提供一个可用供应商）
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
